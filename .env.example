# Create a bot with @BotFather, then keep this file private.
TELEGRAM_BOT_TOKEN=123456789:replace_me
TELEGRAM_CHAT_ID=replace_me

# Optional Codex CLI fallback. It is disabled by default and never searches prices.
# First run `codex login` manually, then enable only ambiguous model matching.
DEAL_RADAR_CODEX_ENABLED=false
CODEX_PATH=codex

# Optional Stage 2.2 overrides. The same values can be set in
# config.json under deal_scoring; environment variables take precedence.
DEAL_SCORING_ENABLED=true
RISK_RESERVE_PERCENT=10
QUICK_SALE_DISCOUNT_PERCENT=15
HOT_MIN_PROFIT_CZK=4000
HOT_MIN_ROI_PERCENT=20
INTERESTING_MIN_ROI_PERCENT=15
HIGH_ROI_PERCENT=100
HOT_MIN_LIQUIDITY_SCORE=50
HOT_MIN_CONFIDENCE_SCORE=50
MANUAL_REVIEW_MAX_LOW_CONFIDENCE=true
TELEGRAM_SEND_HOT=true
TELEGRAM_SEND_INTERESTING=true
TELEGRAM_SEND_MANUAL_REVIEW=true
TELEGRAM_SEND_LOW_PRIORITY=false
TELEGRAM_SEND_REJECT=false

# AI Analysis v1. Off by default; this is also the kill switch.
# Setup guide: docs/openai-setup.md. Never commit a real key.
AI_ANALYSIS_ENABLED=false
AI_SHADOW_MODE=true
AI_CAN_AFFECT_DEAL_STATUS=false
OPENAI_API_KEY=
OPENAI_MODEL_PRIMARY=gpt-5.6-luna
OPENAI_MODEL_FALLBACK=gpt-5.6-terra
OPENAI_FALLBACK_ENABLED=true
OPENAI_MAX_RETRIES=2
OPENAI_TIMEOUT_SECONDS=30
AI_MAX_PARALLEL_REQUESTS=4
# 0 means no per-cycle cap; spending is bounded by the daily budget below.
AI_DEEP_ANALYSIS_LIMIT=0
OPENAI_DAILY_BUDGET_USD=5
OPENAI_WARN_AT_PERCENT=80
OPENAI_STOP_AT_BUDGET=true

# --- Vision: the first listing photo is sent to Level 1 ------------------
# The model reads the photo to tell a real bicycle from an accessory (child
# seat, cycling shoes, spinning trainer) and to spot the bike type when the
# text is bare. Empty OPENAI_VISION_MODEL means the primary model handles it.
AI_VISION_ENABLED=true
OPENAI_VISION_MODEL=
OPENAI_VISION_DETAIL=low
# When AI is live (shadow off) and allowed to affect status, it may hide a
# listing it is at least this sure is NOT a bicycle. It can only hide, never
# promote. Empty result beats a hidden real bike, so keep the bar high.
AI_MIN_REJECT_CONFIDENCE=0.75

# Token prices per 1M tokens. Update when OpenAI changes its price list.
OPENAI_PRIMARY_INPUT_USD_PER_1M=0.20
OPENAI_PRIMARY_CACHED_INPUT_USD_PER_1M=0.02
OPENAI_PRIMARY_OUTPUT_USD_PER_1M=1.20
OPENAI_FALLBACK_INPUT_USD_PER_1M=2.00
OPENAI_FALLBACK_CACHED_INPUT_USD_PER_1M=0.20
OPENAI_FALLBACK_OUTPUT_USD_PER_1M=12.00

# --- AI Analysis Level 2: resale price estimate --------------------------
# Off by default. Turn on only after the Level 1 shadow data looks sane.
AI_PRICE_ESTIMATE_ENABLED=false
# Pricing is a reasoning task, so it runs on a stronger model than extraction.
# Cost stays low because estimates are cached per bike identity, not per ad.
OPENAI_PRICE_MODEL=gpt-5.6-terra
OPENAI_PRICE_INPUT_USD_PER_1M=2.00
OPENAI_PRICE_CACHED_INPUT_USD_PER_1M=0.20
OPENAI_PRICE_OUTPUT_USD_PER_1M=12.00
AI_PRICE_CACHE_TTL_HOURS=720
# An AI-estimated price is a guess, not a measurement, so it may reach
# INTERESTING but not HOT. Flip this only with a reason.
AI_PRICE_ALLOW_HOT=false

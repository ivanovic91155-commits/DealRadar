# Create a bot with @BotFather, then keep this file private.
TELEGRAM_BOT_TOKEN=123456789:replace_me
TELEGRAM_CHAT_ID=replace_me

# Optional Codex CLI fallback. It is disabled by default and never searches prices.
# First run `codex login` manually, then enable only ambiguous model matching.
DEAL_RADAR_CODEX_ENABLED=false
CODEX_PATH=codex

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["canonical_brand", "canonical_model", "generation", "model_year", "candidate_matches"],
  "properties": {
    "canonical_brand": {"type": "string"},
    "canonical_model": {"type": "string"},
    "generation": {"type": "string"},
    "model_year": {"type": ["integer", "null"]},
    "candidate_matches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "is_match", "confidence", "reason"],
        "properties": {
          "candidate_id": {"type": "string"},
          "is_match": {"type": "boolean"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "reason": {"type": "string", "maxLength": 300}
        }
      }
    }
  }
}

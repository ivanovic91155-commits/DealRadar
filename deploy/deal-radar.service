[Unit]
Description=Private bicycle deal radar
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/deal-radar
EnvironmentFile=/opt/deal-radar/.env
ExecStart=/usr/bin/python3 -m deal_radar run
Restart=on-failure
RestartSec=10
User=dealradar

[Install]
WantedBy=multi-user.target
